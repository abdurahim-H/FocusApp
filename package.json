    "ambient-sounds",
    "focus-timer",
    "task-management",
    "cosmic",
    "black-hole"
  ],
  "author": "Cosmic Focus Team",
  "license": "MIT",
  "homepage": "https://github.com/yourusername/cosmic-focus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/cosmic-focus.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/cosmic-focus/issues"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.32.3",
    "esbuild": "^0.28.0",
    "vite": "^8.0.8",
