{
  "name": "cosmic-focus",
  "version": "1.0.0",
  "description": "A stunning 3D productivity application featuring physics-accurate black hole visualizations and immersive cosmic environments",
  "main": "index.html",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && vite build",
    "preview": "vite preview",
    "start": "python3 -m http.server 8000",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:install": "playwright install chromium"
  },
  "keywords": [
    "productivity",
    "pomodoro",
    "3d",
    "babylonjs",
    "webgl",
    "ambient-sounds",
    "focus-timer",
    "task-management",
    "cosmic",
    "black-hole"
  ],
  "author": "Abdurahim Hudulov",
  "license": "MIT",
  "homepage": "https://universefocuses.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdurahim-H/FocusApp.git"
  },
  "bugs": {
    "url": "https://github.com/abdurahim-H/FocusApp/issues"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@cloudflare/vite-plugin": "^1.32.3",
    "@playwright/test": "^1.59.1",
    "esbuild": "^0.28.0",
    "vite": "^8.0.8",
    "wrangler": "^4.83.0"
  },
  "files": [
    "index.html",
    "css/",
    "js/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@preact/signals-core": "^1.14.1",
    "@supabase/supabase-js": "^2.104.1",
    "motion": "^10.18.0"
  }
}
